# Backend
AIOPS_API_HOST=0.0.0.0
AIOPS_API_PORT=4001
AIOPS_LLM_PROVIDER=groq
AIOPS_LLM_MODEL=llama-3.1-8b-instant
AIOPS_LANGSMITH_PROJECT=aegisops-copilot
AIOPS_LANGSMITH_TRACING=true
AIOPS_ENVIRONMENT=development
AIOPS_LOG_FORMAT=auto
AIOPS_LOG_LEVEL=INFO
AIOPS_SSE_KEEPALIVE_SECONDS=15
AIOPS_SSE_STREAM_POLL_SECONDS=1
AIOPS_TRACING_ENABLED=true
AIOPS_OTEL_SERVICE_NAME=aegisops-api
AIOPS_OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318/v1/traces
AIOPS_OTEL_EXCLUDED_URLS=/api/health,/metrics

# Database (asyncpg driver required)
AIOPS_DATABASE_URL=postgresql+asyncpg://aegisops:aegisops@postgres:5432/aegisops

# Redis
AIOPS_REDIS_URL=redis://redis:6379/0

# Celery async task queue (uses Redis DB 1 & 2 to avoid colliding with cache)
AIOPS_CELERY_BROKER_URL=redis://redis:6379/1
AIOPS_CELERY_RESULT_BACKEND=redis://redis:6379/2

# JWT Authentication — CHANGE THE SECRET IN PRODUCTION
AIOPS_JWT_SECRET_KEY=change-me-to-a-long-random-secret-in-production
AIOPS_JWT_ALGORITHM=HS256
AIOPS_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
AIOPS_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial admin user seeded on first startup — CHANGE IN PRODUCTION
AIOPS_INITIAL_ADMIN_USERNAME=admin
AIOPS_INITIAL_ADMIN_PASSWORD=changeme
# Webhook HMAC secret — set to enable signature verification (leave blank in dev)
# PagerDuty: copy the signing secret from your webhook subscription
# Generic: use any shared secret and send X-Webhook-Signature: sha256=<hmac>
AIOPS_WEBHOOK_SECRET=
# Provider keys
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LANGSMITH_API_KEY=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:4001
